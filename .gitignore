# 言語別追加（必要に応じて scaffold 時に append）
# Rust:        target/, Cargo.lock (libの場合は除外しない)
# Node:        node_modules/, dist/, .next/, *.tsbuildinfo
# Python:      __pycache__/, *.pyc, .venv/, dist/, build/
# Swift:       .build/, DerivedData/, Package.resolved (libの場合は除外しない)
# Go:          bin/, vendor/
